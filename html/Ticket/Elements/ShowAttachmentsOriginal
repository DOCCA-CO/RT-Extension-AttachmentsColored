% $m->callback( %ARGS, CallbackName => 'AfterList', TicketObj => $Ticket, Attachments => $Attachments, Documents => \%documents, IsChecked => \%is_checked, ShowMore => \$show_more );

<!-- Hidden container for selected attachments across all pages -->
<div id="selectedAttachmentsContainer" style="display:none;"></div>

<script src="<%$RT::WebPath%>/NoAuth/js/jquery.dataTables.min.js" type="text/javascript"></script>
<script src="<%$RT::WebPath%>/NoAuth/js/dataTables.bootstrap4.min.js" type="text/javascript"></script>
<script type="text/javascript">
	jQuery(function ($) {
		$(document).ready( function () {
			var selectedAttachments = {}; // Track selected attachments across all pages

			// Initialize selectedAttachments with pre-checked values
			$('.att-checkbox:checked').each(function() {
				selectedAttachments[$(this).data('attid')] = true;
			});
			updateHiddenInputs();

			var attachmentsTable = $('#attachments').DataTable({
					language: {
						url: '<%$RT::WebPath%>/NoAuth/js/Hungarian.json'
					},
					ordering: false,
					info:     false
				});

			// When page changes, restore checkbox states for the visible page
			attachmentsTable.on('draw', function() {
				$('.att-checkbox').each(function() {
					var val = $(this).data('attid');
					$(this).prop('checked', !!selectedAttachments[val]);
				});
				updateSelectAllCheckbox();
			});

			// Track individual checkbox changes
			$('#attachments').on('change', '.att-checkbox', function() {
				var val = $(this).data('attid');
				if ($(this).prop('checked')) {
					selectedAttachments[val] = true;
				} else {
					delete selectedAttachments[val];
				}
				updateHiddenInputs();
				updateSelectAllCheckbox();
			});

			// Select/deselect all across ALL pages
			$('#SelectAllAttachments').on('change', function() {
				var isChecked = $(this).prop('checked');
				
				if (isChecked) {
					// Select all rows across ALL pages
					attachmentsTable.rows().every(function() {
						var $checkbox = $(this.node()).find('.att-checkbox');
						if ($checkbox.length) {
							selectedAttachments[$checkbox.data('attid')] = true;
							$checkbox.prop('checked', true);
						}
					});
				} else {
					// Deselect all
					selectedAttachments = {};
					attachmentsTable.rows().every(function() {
						$(this.node()).find('.att-checkbox').prop('checked', false);
					});
				}
				updateHiddenInputs();
			});

			// Update hidden inputs that will be submitted with the form
			function updateHiddenInputs() {
				var container = $('#selectedAttachmentsContainer');
				container.empty();
				for (var attId in selectedAttachments) {
					container.append('<input type="hidden" name="AttachExisting" value="' + attId + '" />');
				}
			}

			// Update "select all" checkbox state based on selections
			function updateSelectAllCheckbox() {
				var totalCount = 0;
				var selectedCount = 0;
				attachmentsTable.rows().every(function() {
					var $checkbox = $(this.node()).find('.att-checkbox');
					if ($checkbox.length) {
						totalCount++;
						if (selectedAttachments[$checkbox.data('attid')]) {
							selectedCount++;
						}
					}
				});
				var $selectAll = $('#SelectAllAttachments');
				if (selectedCount === 0) {
					$selectAll.prop('checked', false);
					$selectAll.prop('indeterminate', false);
				} else if (selectedCount === totalCount) {
					$selectAll.prop('checked', true);
					$selectAll.prop('indeterminate', false);
				} else {
					$selectAll.prop('checked', false);
					$selectAll.prop('indeterminate', true);
				}
			}
		})
	});
</script>


% if ($show_more) {
<span class="show-more-link">
% my %params = %ARGS;
% delete $params{Ticket};
% delete $params{Attachments};
% delete $params{Count};
% my $query = $m->comp('/Elements/QueryString', %params, id => $Ticket->id );
% my $url   = RT->Config->Get('WebPath')."/Helpers/TicketAttachments?$query";

<script type="text/javascript">
    function showAllAttachments(node) {
        var container = node.closest('.attachment-list');
        var params = node.closest('form').find('input[name=AttachExisting]').serialize();

        node.parent().text(<% loc('Loading...') | n,j%>);

        var url = <% $url |n,j %>;
        if (params) url += '&' + params;
        container.load(url);
    }
</script>

<a href="#" class="button btn btn-primary" onclick="showAllAttachments(jQuery(this)); return false;" ><% loc('Show all') %></a>

</span>
% }

</div>
</&>

<%INIT>
use utf8;
# If we haven't been passed in an Attachments object (through the precaching mechanism)
# then we need to find one
$Attachments ||= $Ticket->Attachments;

# Avoid applying limits to this collection that may be used elsewhere
# (e.g. transaction display)
$Attachments = $Attachments->Clone;

# Remember, each message in a transaction is an attachment; we only
# want named attachments (real files)
$Attachments->LimitHasFilename;

my $show_more = 0;
my %documents;

# show newest first
$Attachments->OrderByCols(
    { FIELD => 'Created', ORDER => 'DESC' },
    { FIELD => 'id',      ORDER => 'DESC' },
);

while ( my $attach = $Attachments->Next() ) {
## [DOCCA #4601562] begin
    my $catt = ($attach->FirstAttribute('Category')?$attach->FirstAttribute('Category')->Content:'X');
    next if ( $catt eq 'hidden' );
## [DOCCA #4601562] end

   # display "show more" only when there will be more attachments
##   if (defined($Count) && --$Count < 0) {
##       $show_more = 1;
##       last;
##   }
   push @{ $documents{ $attach->Filename } }, $attach;
}

my %is_checked = map { $_ => 1 } @Checked;

return if !$show_more && keys %documents == 0;
</%INIT>
<%ARGS>
$Ticket => undef
$Attachments => undef
$DisplayPath => $session{'CurrentUser'}->Privileged ? 'Ticket' : 'SelfService'
$HideTitleBox => 0
$Selectable => 0
$Count => undef
@Checked => ()
</%ARGS>

