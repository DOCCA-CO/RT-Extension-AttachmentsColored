										nselect += "<option value='" + element.id + "'" + (element.id == oData.node ? " selected" : "") + ">" + element.text + "</option>";
									});
									nselect += "</select>";
%#									console.log("Folder: " + nselect);
									$(nTd).html( nselect );
%#									$(nTd).html( "<select class='selectnode' style='width:200px;' id='sel-" + oData.attid + "' onchange='setFolder(this.id, this.value);'><option></option></select>" );

								}
