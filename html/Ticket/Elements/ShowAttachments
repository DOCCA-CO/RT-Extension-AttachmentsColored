								}
							}],
						autoWidth: false,
						scrollX: false,
						columnDefs: [
								{ type: 'file-size', targets: 5 },
								{ width: '30px', targets: 0, className: 'dt-nowrap' },
								{ width: '120px', targets: 1, className: 'dt-nowrap' },
								{ width: '80px', targets: 3, className: 'dt-nowrap' },
								{ width: '90px', targets: 4, className: 'dt-nowrap' },
								{ width: '60px', targets: 5, className: 'dt-nowrap' },
								{ width: '150px', targets: 6, className: 'dt-nowrap' },
								{ width: '120px', targets: 7, className: 'dt-nowrap' }
							],
		                order: [ 3, 'asc' ],
					});
				}
			}).then(function (data) {
			    // Event delegation for dynamically created elements
				$(document).on('mouseenter', '.__dropdown', function() {
					const dropdownContent = $(this).find('.__dropdown-content');
					const rect = $(this)[0].getBoundingClientRect();
					const viewportHeight = $(window).height();
					const viewportWidth = $(window).width();

					// Remove any existing positioning classes
					dropdownContent.removeClass('above below');

					// Calculate horizontal position - align left edge with element, but don't overflow right side
					let leftPos = rect.left;
					const dropdownWidth = 480; // max-width from CSS
					if (leftPos + dropdownWidth > viewportWidth) {
						leftPos = Math.max(10, viewportWidth - dropdownWidth - 10);
					}

					// Check if the element is in the upper half of the screen
					if (rect.top < viewportHeight / 2) {
						// Position below the element
						dropdownContent.addClass('below');
						dropdownContent.css({
							'top': rect.bottom + 'px',
							'bottom': 'auto',
							'left': leftPos + 'px'
						});
					} else {
						// Position above the element
						dropdownContent.addClass('above');
						dropdownContent.css({
							'top': 'auto',
							'bottom': (viewportHeight - rect.top) + 'px',
							'left': leftPos + 'px'
						});
					}

					// Ensure the dropdown is visible
					dropdownContent.css('display', 'block');
				});

			    // Hide dropdown when mouse leaves the dropdown area
				$(document).on('mouseleave', '.__dropdown', function() {
					$(this).find('.__dropdown-content').css('display', 'none');
				});

				// Hide dropdown when mouse leaves the dropdown area
				$('.__dropdown').on('mouseleave', function() {
					$(this).find('.__dropdown-content').css('display', 'none');
				});
			});
		});
    });

    function setCategory( row, cell, radio, value ) {
		console.log(row, cell, radio, value);
		if (!isClassDefined('darkmode')) {
			jQuery(dt.row(row).node()).css( 'background', colors[value] );
		} else {
			jQuery(dt.row(row).node()).find('td').attr('style', 'background:' + colors[value] + ' !important');
		}
		if (value == 'hidden') {
			jQuery( dt.row(row).node() ).find("input[type='hidden'][name^='rad']").val('hidden');
			if (!isClassDefined('darkmode')) {
				jQuery(dt.row(row).node()).css( 'background', '#DCDCDC' );
			} else {
				jQuery(dt.row(row).node()).find('td').attr('style', 'background:#DCDCDC !important');
			}
			if (!jQuery("#showhide").is(":checked")) {
				jQuery(dt.row(row).node()).hide();	
			}
		};
		jQuery.ajax({
			type: 'POST',
			url: '<%RT->Config->Get('WebPath')%>/Ajax/AjaxModifyCategory',
			data: {
				'Value' : value,
				'attachId' : radio.replace("rad", ""),
			},
			success:function(){
