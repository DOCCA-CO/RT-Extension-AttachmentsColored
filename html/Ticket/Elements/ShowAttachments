							$(nTd).html( "<input type='checkbox' name='att' value='"+oData.attid+"' data-link='"+oData.checkbox+"' "+isChecked+" onchange='handleCheckboxChange(this)' />" );
						}},
							{ "data":"category",
		                    	//"orderable": false,
								"fnCreatedCell": function (nTd, sData, oData, iRow, iCol) {
									var rgroup = "";
									for (var key in colors) {
										rgroup += "<label class='__container'>";
										rgroup += "<input type='radio' onchange='setCategory(" + iRow + ","  + iCol + ", this.name, this.value);' name='rad" + oData.attid + "' id='rad-" + oData.attid + "-" + key + "' value='" + key +"'";
										rgroup += (key == sData)?" checked":"";
										rgroup += " />";
										rgroup += "<span class='checkmark' style='background-color: " + colors[key] + " !important' title='" + key + "'></span>";
										rgroup += "</label>";
									}

									rgroup += "</label>";
									rgroup += "<label class='__container'>";
//									rgroup += "id='del-" + oData.attid + "-label'";
//									rgroup += (sData == 'X')?" style='display:none;'>":">";
									// &#x21bb;
									// &#x238C;
									rgroup += "<span title='<%loc('Unhighlight')%>' id='del" + oData.attid + "' class='checkmark' style='background:#FFF !important;text-align:center;color:#000 !important;' onclick='delCategory("+iRow+", this.id); return true;'>&nbsp;</span>";
									rgroup += "</label>";

									//&#x2612;
									rgroup += "<label class='__container'>";
									rgroup += "<span title='<%loc('Hide')%>' id='hidden-" + oData.attid + "' onclick='setCategory(" + iRow + ","  + iCol + ", \"rad" + oData.attid + "\", \"hidden\");' class='checkmark' style='background:#DCDCDC !important;text-align:center;";
									rgroup += (sData == "hidden")?"color:#000 !important;":"color:#000 !important;";
									rgroup += "'>&#x2715;</span>";
									rgroup += "<input type='hidden' name='rad" + oData.attid + "' id='rad-" + oData.attid + "-hidden' value='";
									rgroup += (sData == "hidden")?"hidden":"";
									rgroup += "'>";
									$(nTd).css({ 'min-width': '80px', 'max-width': '120px' });
									$(nTd).html( rgroup );
									return oData.attid;
								}
							},
							{ "data":"filename",
							"fnCreatedCell": function (nTd, sData, oData, iRow, iCol) {
								var showFull = <% RT->Config->Get('ShowFullFilename', $session{'CurrentUser'}) ? 'true' : 'false' %>;
								if (showFull) {
									$(nTd).addClass('__fullFilename');
