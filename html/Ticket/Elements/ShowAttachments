	}

    function handleCheckboxChange(checkbox) {
        var attid = checkbox.value;
        var link = checkbox.getAttribute('data-link');
        
        if (checkbox.checked) {
            selectedRows[attid] = {
                attid: attid,
                link: link
            };
        } else {
            delete selectedRows[attid];
        }
        
        // Update "select all" checkbox state
        var totalRows = dt.rows().count();
        var selectedCount = Object.keys(selectedRows).length;
        var selectAllCheckbox = document.getElementById('checkAll');
        
        if (selectedCount === 0) {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
        } else if (selectedCount === totalRows) {
            selectAllCheckbox.checked = true;
            selectAllCheckbox.indeterminate = false;
        } else {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = true;
        }
    }

    function checkAllClick(cb) {
        // Clear or populate selectedRows based on check all state
        if (cb.checked) {
            // Select all rows
            dt.rows().every(function() {
                var data = this.data();
                selectedRows[data.attid] = {
                    attid: data.attid,
                    link: data.checkbox
                };
            });
        } else {
            // Deselect all rows
            selectedRows = {};
        }
        
        // Update visible checkboxes
        jQuery('input[name="att"]:checkbox').not(cb).prop('checked', cb.checked);
    }

